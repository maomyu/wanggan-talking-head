{
  "status": "designed",
  "sourceBinding": "499f8c4c4b6535c831f05604e0e20354d57d2cd2bad058dfc2d56e5975b57f03",
  "combination": "水墨写意 × 同物接力",
  "axis": "rhythm",
  "speechAnchors": [
    {
      "id": 1,
      "startFrame": 0,
      "endFrame": 58,
      "text": "为什么越努力上班越存不到钱",
      "sourceStart": 0,
      "sourceEnd": 1.9333333333333333,
      "segment": "A",
      "sourceId": 1
    },
    {
      "id": 2,
      "startFrame": 58,
      "endFrame": 95,
      "text": "今天就给普通人讲一讲",
      "sourceStart": 1.9333333333333333,
      "sourceEnd": 3.1666666666666665,
      "segment": "A",
      "sourceId": 2
    },
    {
      "id": 3,
      "startFrame": 95,
      "endFrame": 149,
      "text": "当下最接地气的财富真相",
      "sourceStart": 3.1666666666666665,
      "sourceEnd": 4.966666666666667,
      "segment": "A",
      "sourceId": 3
    },
    {
      "id": 4,
      "startFrame": 149,
      "endFrame": 198,
      "text": "很多人习惯跟风消费",
      "sourceStart": 4.966666666666667,
      "sourceEnd": 6.6,
      "segment": "A",
      "sourceId": 4
    },
    {
      "id": 5,
      "startFrame": 198,
      "endFrame": 224,
      "text": "盲目打理资产",
      "sourceStart": 6.6,
      "sourceEnd": 7.466666666666667,
      "segment": "A",
      "sourceId": 5
    },
    {
      "id": 6,
      "startFrame": 224,
      "endFrame": 266,
      "text": "要么透支负债前行",
      "sourceStart": 7.466666666666667,
      "sourceEnd": 8.866666666666667,
      "segment": "A",
      "sourceId": 6
    },
    {
      "id": 7,
      "startFrame": 266,
      "endFrame": 310,
      "text": "要么跟风盲目炒股",
      "sourceStart": 8.866666666666667,
      "sourceEnd": 10.333333333333334,
      "segment": "A",
      "sourceId": 7
    },
    {
      "id": 8,
      "startFrame": 310,
      "endFrame": 349,
      "text": "最后本金受损",
      "sourceStart": 10.333333333333334,
      "sourceEnd": 11.633333333333333,
      "segment": "A",
      "sourceId": 8
    },
    {
      "id": 9,
      "startFrame": 349,
      "endFrame": 388,
      "text": "生活压力越来越大",
      "sourceStart": 11.633333333333333,
      "sourceEnd": 12.933333333333334,
      "segment": "A",
      "sourceId": 9
    },
    {
      "id": 10,
      "startFrame": 388,
      "endFrame": 461,
      "text": "给大家三个普通人的财经底线",
      "sourceStart": 12.933333333333334,
      "sourceEnd": 15.366666666666667,
      "segment": "A",
      "sourceId": 10
    },
    {
      "id": 11,
      "startFrame": 461,
      "endFrame": 516,
      "text": "第一，砍掉无效消费",
      "sourceStart": 15.366666666666667,
      "sourceEnd": 17.2,
      "segment": "A",
      "sourceId": 11
    },
    {
      "id": 12,
      "startFrame": 516,
      "endFrame": 563,
      "text": "戒掉冲动的购物",
      "sourceStart": 17.2,
      "sourceEnd": 18.766666666666666,
      "segment": "A",
      "sourceId": 12
    },
    {
      "id": 13,
      "startFrame": 563,
      "endFrame": 616,
      "text": "分清楚想要和需要",
      "sourceStart": 18.766666666666666,
      "sourceEnd": 20.533333333333335,
      "segment": "A",
      "sourceId": 13
    },
    {
      "id": 14,
      "startFrame": 616,
      "endFrame": 686,
      "text": "第二守住本金永远优先",
      "sourceStart": 20.533333333333335,
      "sourceEnd": 22.866666666666667,
      "segment": "A",
      "sourceId": 14
    },
    {
      "id": 15,
      "startFrame": 686,
      "endFrame": 783,
      "text": "市面上夸大收益理财的都暗藏风险",
      "sourceStart": 22.866666666666667,
      "sourceEnd": 26.1,
      "segment": "A",
      "sourceId": 15
    },
    {
      "id": 16,
      "startFrame": 783,
      "endFrame": 856,
      "text": "普通人要远离投机跟炒作",
      "sourceStart": 26.1,
      "sourceEnd": 28.533333333333335,
      "segment": "A",
      "sourceId": 16
    },
    {
      "id": 17,
      "startFrame": 856,
      "endFrame": 898,
      "text": "第三减少负债",
      "sourceStart": 28.533333333333335,
      "sourceEnd": 29.933333333333334,
      "segment": "A",
      "sourceId": 17
    },
    {
      "id": 18,
      "startFrame": 898,
      "endFrame": 959,
      "text": "财富从来不是靠蛮力争取的",
      "sourceStart": 29.933333333333334,
      "sourceEnd": 31.966666666666665,
      "segment": "A",
      "sourceId": 18
    },
    {
      "id": 19,
      "startFrame": 959,
      "endFrame": 1003,
      "text": "而是靠认知筛选",
      "sourceStart": 31.966666666666665,
      "sourceEnd": 33.43333333333333,
      "segment": "A",
      "sourceId": 19
    },
    {
      "id": 20,
      "startFrame": 1003,
      "endFrame": 1036,
      "text": "不跟风不浮躁",
      "sourceStart": 33.43333333333333,
      "sourceEnd": 34.53333333333333,
      "segment": "A",
      "sourceId": 20
    },
    {
      "id": 21,
      "startFrame": 1036,
      "endFrame": 1100,
      "text": "才是普通人该走的路",
      "sourceStart": 34.53333333333333,
      "sourceEnd": 36.666666666666664,
      "segment": "A",
      "sourceId": 21
    }
  ],
